# Base URL de la API (sin barra final)
VITE_API_URL=http://localhost:3000/api/v1
# Producción: https://portfolio-api-u5sx.onrender.com/api/v1

# Observabilidad (Sentry). El DSN es público por diseño; déjalo vacío para desactivar.
VITE_SENTRY_DSN=
# Entorno reportado a Sentry: development | production
VITE_ENV=development

# Credenciales del admin para los E2E del panel (server local real).
# Copiar a `.env` (gitignored) y rellenar. NUNCA commitear valores reales
# ni ponerlas en variables VITE_* (se embeben en el bundle público).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
